# ============================================================
# EXPLORE WITH SAKAR — Environment Variables
# Copy this file to .env.local for local development.
# Set all REQUIRED variables in Vercel project settings for production.
# ============================================================

# ── MongoDB (REQUIRED in production) ────────────────────────
# Connection string from MongoDB Atlas (mongodb+srv://...)
MONGODB_URI=

# Database name.
#   Production (Vercel):  explore_with_sakar
#   Local dev / staging:  explore_with_sakar_dev
MONGODB_DB=explore_with_sakar

# ── Admin Authentication (REQUIRED in production) ────────────
# A long random string used to sign admin JWT session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# *** If this is missing in Vercel, ALL admin API calls return 401 and admin pages show empty. ***
ADMIN_JWT_SECRET=

# Initial admin credentials (used only on first boot to seed the admin user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Bootstrap / Sync (OPTIONAL) ──────────────────────────────
# Secret used to call /api/admin/sync-seed and /api/admin/debug-db via
# x-sync-secret header when the admin session is not available.
# Set to a random string in Vercel env vars.
SYNC_SECRET=

# ── Development Only ─────────────────────────────────────────
# Set to 'file' to use .data/dev-store.json instead of MongoDB in local dev.
# Leave unset in production — this variable has no effect when VERCEL=1.
CMS_STORAGE=

# Optional comma-separated DNS servers for Atlas SRV resolution fallback.
# Useful if your network blocks port 53 DNS for mongodb.net domains.
# Example: 8.8.8.8,1.1.1.1
MONGODB_DNS_SERVERS=
