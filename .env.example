# MongoDB connection string (e.g. mongodb+srv://... or non-SRV mongodb://...)
MONGODB_URI=

# MongoDB database name (default: explore_with_sakar)
MONGODB_DB=

# Secret key for JWT signing in admin authentication
ADMIN_JWT_SECRET=

# Initial admin username for first-time bootstrapping
ADMIN_USERNAME=

# Initial admin password for first-time bootstrapping
ADMIN_PASSWORD=

# Storage mode for development ('file' for offline dev using .data/dev-store.json)
CMS_STORAGE=

# Optional comma-separated DNS servers for SRV resolution fallback (e.g. 8.8.8.8,1.1.1.1)
MONGODB_DNS_SERVERS=
